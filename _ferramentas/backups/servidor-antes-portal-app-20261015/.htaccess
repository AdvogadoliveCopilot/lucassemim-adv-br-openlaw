# ================================================================== #
# === .HTACCESS: ELITE SEO V7 — SEGURO & COMPATÍVEL APACHE 2026   === #
# === Site: lucassemim.adv.br — Advocacia Criminal — Sabará/BH    === #
# ================================================================== #

# --- 1. CONFIGURAÇÃO DE CHARSET ---
AddDefaultCharset UTF-8

# --- 2. COMPRESSÃO DE DADOS (GZIP / DEFLATE) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/ld+json image/svg+xml
    SetEnvIfNoCase Request_URI \.(gif|jpe?g|png|webp|gz|zip|bz2)$ no-gzip
</IfModule>

# --- 3. CACHE INTELIGENTE DE NAVEGADOR (MOD_EXPIRES) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                  "access plus 0 seconds"
    ExpiresByType text/css                   "access plus 1 year"
    ExpiresByType application/javascript     "access plus 1 year"
    ExpiresByType image/jpeg                 "access plus 1 year"
    ExpiresByType image/webp                 "access plus 1 year"
    ExpiresByType image/png                  "access plus 1 year"
    ExpiresByType image/svg+xml              "access plus 1 year"
    ExpiresByType image/x-icon               "access plus 1 year"
    ExpiresByType font/woff2                 "access plus 1 year"
    ExpiresByType font/woff                  "access plus 1 year"
    ExpiresByType font/ttf                   "access plus 1 year"
    ExpiresByType application/json           "access plus 1 hour"
    ExpiresByType application/ld+json        "access plus 1 day"
    ExpiresByType text/xml                   "access plus 1 day"
</IfModule>

# --- 4. CABEÇALHOS DE SEGURANÇA E ACESSIBILIDADE DE IA (GEO / CORS) ---
<IfModule mod_headers.c>
    # Segurança Essencial
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # CORS Aberto para Citações e Leitura de IAs (ChatGPT, Claude, Gemini, Perplexity)
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"

    # Indexação Máxima no Google e Buscadores
    Header always set X-Robots-Tag "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"

    # ESCUDO 04/10/2026: paginas privadas nunca entram no Google (a regra mais especifica vence a global)
    <FilesMatch "^(painel-cliente|painel-gestao-admin|painel-processo|sala-reuniao)\.html$">
        Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    </FilesMatch>

    # ESCUDO 04/10/2026: CSP minimo — impede <base> forjado, plugins e embutir o site em outro dominio.
    # (nao restringe scripts nem estilos, entao nao quebra nenhuma pagina)
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"

    # Cache Control Seguro para HTML (Revalidação rápida)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, must-revalidate"
    </FilesMatch>

    # Cache Control para Assets Estáticos (1 ano)
    <FilesMatch "\.(css|js|jpg|jpeg|webp|png|gif|svg|ico|woff|woff2|ttf)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>

# --- 5. MOTOR DE REESCRITA (REWRITE ENGINE) ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 5.1. Redirecionar www -> non-www (Canônico Oficial: https://lucassemim.adv.br)
    RewriteCond %{HTTP_HOST} ^www\.lucassemim\.adv\.br [NC]
    RewriteRule ^(.*)$ https://lucassemim.adv.br/$1 [R=301,L]

    # 5.2. Forçar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://lucassemim.adv.br/$1 [R=301,L]

    # 5.3. Remover index.html visível da raiz
    RewriteCond %{THE_REQUEST} ^GET\ /index\.html [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # 5.4. URLs amigáveis (remove .html visível)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^\.]+)/?$ $1.html [NC,L]

    # 5.5. Bloqueio de injeções e ataques básicos
    RewriteCond %{QUERY_STRING} (base64_encode|eval\(|javascript:|<script) [NC]
    RewriteRule .* - [F,L]

    # 5.6. ESCUDO 04/10/2026 — mais travas (somente regras ja suportadas por este servidor)
    # a) metodos de depuracao (obs.: o Apache ignora .htaccess para TRACE; TRACK/DEBUG sao barrados aqui)
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG) [NC]
    RewriteRule .* - [F,L]
    # b) ferramentas de varredura / ataque automatico
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|masscan|acunetix|wpscan|havij|zgrab|nessus|dirbuster|gobuster|nuclei) [NC]
    RewriteRule .* - [F,L]
    # c) traversal, byte nulo, SQLi, iframe e script (cru ou codificado como %3C) na query string
    RewriteCond %{QUERY_STRING} (\.\./|%2e%2e|%00|union(%20|\+)+select|information_schema|<iframe|%3Ciframe|%3Cscript) [NC]
    RewriteRule .* - [F,L]
    # d) pastas ocultas (.git, .svn, .env...) em qualquer nivel
    RewriteRule (^|/)\.(git|svn|hg|env|idea|vscode|DS_Store) - [F,L]
    # e) codigo-fonte, logs, copias e pacotes nunca saem pela web
    RewriteRule \.(gs|md|log|ini|sh|py|bak|old|orig|swp|sql|zip|tar|gz|7z|rar)$ - [F,L,NC]
    # f) pastas de trabalho que nao devem estar publicas
    RewriteRule ^apps-script/ - [F,L]
    RewriteRule ^civel/Claude.outputs/ - [F,L]
    RewriteRule ^clientes/ - [F,L]
    # g) exportacao/backup do projeto Apps Script (traz codigo-fonte e pode trazer segredos)
    RewriteRule (^|/)Advogado.Live[^/]*\.json$ - [F,L,NC]
    # h) JSON: so os arquivos publicos do site; qualquer outro .json e negado
    RewriteCond %{REQUEST_URI} \.json$ [NC]
    RewriteCond %{REQUEST_URI} !(^|/)(manifest|noticias|seo-intelligence|version)\.json$ [NC]
    RewriteRule .* - [F,L]
    # i) alvos tipicos de scanner (o site nao usa WordPress, phpMyAdmin etc.)
    RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|pma|adminer|cgi-bin|vendor)(/|$) - [F,L,NC]
</IfModule>

# --- 6. BLOQUEIO DE ARQUIVOS SENSÍVEIS ---
# ESCUDO 04/10/2026: o arquivo com a chave da IA nunca pode ser baixado pelo navegador
# (o PHP continua lendo normalmente, pois o include usa o disco, nao o HTTP).
<Files ".claude-config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<FilesMatch "(^\.htaccess|\.env|\.git|composer\.|package\.json|\.bak|\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

